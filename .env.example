# Supabase (get from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin CMS — simple cookie-session password (set a long random string)
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SESSION_SECRET=change-me-to-a-32-char-random-secret

# Site
NEXT_PUBLIC_SITE_URL=https://geetprince.me

# On-demand ISR revalidation secret
REVALIDATE_SECRET=change-me-to-another-random-secret

# GEET-SENTINEL — SERP providers (optional; falls back to labeled simulated diagnostics)
# Tip: you can also paste keys in /admin/seo-bot (Bot Configuration vault) —
# env vars win when both are set, and the vault needs no restart.
# Get a key at https://serper.dev (Google India results, gl=in)
SERPER_API_KEY=
# ...or use Google Custom Search: key + search engine ID
GOOGLE_CUSTOM_SEARCH_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Vercel Cron bearer for /api/cron/seo-bot (set in Vercel env + cron job config)
CRON_SECRET=change-me-to-a-cron-bearer-secret
